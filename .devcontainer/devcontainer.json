{
  "name": "Wheaton LLM Class",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "donjayamanne.vscode-default-python-kernel"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.pixi/envs/default/bin/python"
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode .pixi && pixi install && (ollama serve > /tmp/ollama.log 2>&1 &) && until ollama list > /dev/null 2>&1; do sleep 1; done && ollama pull llama3.2:1b-text-q5_K_S && ollama pull llama3.2:1b",
  "postStartCommand": "pgrep -x ollama > /dev/null || nohup ollama serve > /tmp/ollama.log 2>&1 &"
}
