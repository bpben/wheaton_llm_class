{
  "name": "Wheaton LLM Class",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "donjayamanne.vscode-default-python-kernel"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.pixi/envs/default/bin/python"
      }
    }
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode .pixi && pixi install && bash .devcontainer/start-ollama.sh && ollama pull llama3.2:1b-text-q5_K_S && ollama pull llama3.2:1b",
  "postAttachCommand": "bash .devcontainer/start-ollama.sh"
}
